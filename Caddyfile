{
	email {$ACME_EMAIL}
}

{$WEB_DOMAIN} {
	encode gzip
	reverse_proxy web:3000
}

{$ADMIN_DOMAIN} {
	encode gzip
	reverse_proxy admin:3000
}

{$API_DOMAIN} {
	encode gzip
	reverse_proxy backend:8080 {
		# Liveness only (process serves HTTP). Do NOT switch to /health/ready: with a single
		# upstream, a PostgreSQL/Redis blip would make Caddy return 502/503 for every API request.
		health_uri /health
		health_interval 30s
	}
}
