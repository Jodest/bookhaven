{
	email {$ACME_EMAIL}
}

# HSTS only: Caddy is the sole component that knows the connection is TLS.
# All other security headers (CSP, X-Frame-Options, nosniff, Referrer-Policy, ...) are owned
# by the apps (Next.js headers() / Echo SecurityHeaders middleware) - do not add them here.
# No includeSubDomains/preload until prod has run on TLS for a while (docs/features/security-headers.md).
(hsts) {
	header Strict-Transport-Security "max-age=31536000"
}

{$WEB_DOMAIN} {
	import hsts
	encode gzip
	reverse_proxy web:3000
}

{$ADMIN_DOMAIN} {
	import hsts
	encode gzip
	reverse_proxy admin:3000
}

{$API_DOMAIN} {
	import hsts
	encode gzip
	reverse_proxy backend:8080 {
		# Liveness only (process serves HTTP). Do NOT switch to /health/ready: with a single
		# upstream, a PostgreSQL/Redis blip would make Caddy return 502/503 for every API request.
		health_uri /health
		health_interval 30s
	}
}
