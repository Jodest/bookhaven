# Production environment for the VPS. Copy to /opt/bookhaven/.env on the server
# (chmod 600, root-owned) and fill in real values. NEVER commit the real file.

APP_ENV=production

# Container images (GHCR) — pushed automatically by .github/workflows/deploy.yml
# Owner must be lowercase (GHCR requirement) regardless of the GitHub account's display case.
BACKEND_IMAGE=ghcr.io/jodest/bookhaven-backend
WEB_IMAGE=ghcr.io/jodest/bookhaven-web
ADMIN_IMAGE=ghcr.io/jodest/bookhaven-admin
IMAGE_TAG=latest

# Domains (must already point to this server's IP via DNS A-records)
WEB_DOMAIN=bookhaven.example.com
ADMIN_DOMAIN=admin.bookhaven.example.com
API_DOMAIN=api.bookhaven.example.com
ACME_EMAIL=you@example.com

# Database — generate a strong password, e.g.: openssl rand -base64 24
POSTGRES_USER=bookhaven
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bookhaven

# Backend — generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=24h
LOG_LEVEL=info

# WEB_BASE_URL (public web origin for links in emails, e.g. /verify-email) is
# NOT set here: docker-compose.prod.yml derives it as https://${WEB_DOMAIN}.

# Must list the exact public origins of web/admin (comma-separated, no trailing slash)
CORS_ALLOWED_ORIGINS=https://bookhaven.example.com,https://admin.bookhaven.example.com

# OAuth (optional — leave blank until configured with the provider)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outbound email (worker only) — see docs/DEPLOYMENT.md "Email (SMTP)".
# Leave SMTP_HOST blank to disable sending: emails are then only logged
# (bodies are never logged in production) and the worker warns at startup.
# SMTP_PORT: 587 = STARTTLS, 465 = implicit TLS (port 25 is often blocked by VPS providers).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# Provider SMTP password / API key — secret, never commit or paste elsewhere.
SMTP_PASSWORD=
# Must be on the domain that has SPF/DKIM/DMARC records, e.g. BookHaven <noreply@bookhaven.example.com>
MAIL_FROM=

# AI pre-moderation of pending books (off by default) — see docs/DEPLOYMENT.md
# "AI pre-moderation". Both the api and the worker need the flag and the key.
# ANTHROPIC_API_KEY is a secret: never commit it.
AI_MODERATION_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODERATION_MODEL=claude-haiku-5-5
AI_MODERATION_CRON="*/30 * * * *"
AI_MODERATION_BATCH=50

# AI curator of author import lists (off by default) — see docs/DEPLOYMENT.md
# "AI author curation". Shares ANTHROPIC_API_KEY; both the api and the worker
# need the flag (and the key).
AI_CURATOR_ENABLED=false
AI_CURATOR_MODEL=claude-haiku-5-5
