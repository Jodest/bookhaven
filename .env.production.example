# Production environment for the VPS. Copy to /opt/bookhaven/.env on the server
# (chmod 600, root-owned) and fill in real values. NEVER commit the real file.

APP_ENV=production

# Container images (GHCR) — pushed automatically by .github/workflows/deploy.yml
# Owner must be lowercase (GHCR requirement) regardless of the GitHub account's display case.
BACKEND_IMAGE=ghcr.io/jodest/bookhaven-backend
WEB_IMAGE=ghcr.io/jodest/bookhaven-web
ADMIN_IMAGE=ghcr.io/jodest/bookhaven-admin
IMAGE_TAG=latest

# Domains (must already point to this server's IP via DNS A-records)
WEB_DOMAIN=bookhaven.example.com
ADMIN_DOMAIN=admin.bookhaven.example.com
API_DOMAIN=api.bookhaven.example.com
ACME_EMAIL=you@example.com

# Database — generate a strong password, e.g.: openssl rand -base64 24
POSTGRES_USER=bookhaven
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bookhaven

# Backend — generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=24h
LOG_LEVEL=info

# WEB_BASE_URL (public web origin for links in emails, e.g. /verify-email) is
# NOT set here: docker-compose.prod.yml derives it as https://${WEB_DOMAIN}.

# Must list the exact public origins of web/admin (comma-separated, no trailing slash)
CORS_ALLOWED_ORIGINS=https://bookhaven.example.com,https://admin.bookhaven.example.com

# OAuth (optional — leave blank until configured with the provider)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outbound email (worker only) — see docs/DEPLOYMENT.md "Email (SMTP)".
# Leave SMTP_HOST blank to disable sending: emails are then only logged
# (bodies are never logged in production) and the worker warns at startup.
# SMTP_PORT: 587 = STARTTLS, 465 = implicit TLS (port 25 is often blocked by VPS providers).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# Provider SMTP password / API key — secret, never commit or paste elsewhere.
SMTP_PASSWORD=
# Must be on the domain that has SPF/DKIM/DMARC records, e.g. BookHaven <noreply@bookhaven.example.com>
MAIL_FROM=

# AI pre-moderation of pending books (off by default) — see docs/DEPLOYMENT.md
# "AI pre-moderation". Both the api and the worker need the flag and the key.
# ANTHROPIC_API_KEY is a secret: never commit it.
AI_MODERATION_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODERATION_MODEL=claude-haiku-5-5
AI_MODERATION_CRON="*/30 * * * *"
AI_MODERATION_BATCH=50

# AI curator of author import lists (off by default) — see docs/DEPLOYMENT.md
# "AI author curation". Shares ANTHROPIC_API_KEY; both the api and the worker
# need the flag (and the key).
AI_CURATOR_ENABLED=false
AI_CURATOR_MODEL=claude-haiku-5-5

# AI drafts of manual curated collections (off by default) — see
# docs/DEPLOYMENT.md "AI collection drafts". Shares ANTHROPIC_API_KEY; both the
# api and the worker need the flag (and the key).
AI_COLLECTIONS_ENABLED=false
AI_COLLECTIONS_MODEL=claude-sonnet-5-5

# AI genre suggestions (off by default) — see docs/DEPLOYMENT.md "AI genre
# suggestions". Shares ANTHROPIC_API_KEY; both the api and the worker need the
# flag (and the key). The analysis only proposes genre merges and rejections:
# nothing changes without an admin. AI_GENRES_CRON is a UTC cron spec (empty =
# no weekly run, manual only); AI_GENRES_BATCH is genres per model request.
AI_GENRES_ENABLED=false
AI_GENRES_MODEL=claude-sonnet-5-5
AI_GENRES_CRON="0 3 * * 1"
AI_GENRES_BATCH=300

# Auth cookies are Secure by default in prod compose (AUTH_COOKIE_SECURE=true).
# Only turn off for an HTTP-only test box; browsers drop Secure cookies without TLS.
# AUTH_COOKIE_SECURE=false

# Database pool limits per process (api, worker, similarity). Optional; defaults shown.
# Keep processes x DB_MAX_OPEN_CONNS below PostgreSQL max_connections (100 by default).
# DB_MAX_OPEN_CONNS=20
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME=30m
# DB_CONN_MAX_IDLE_TIME=5m
# HTTP server timeouts of the api (Go duration; 0 = no limit; invalid falls back to the default).
# HTTP_READ_HEADER_TIMEOUT=10s
# HTTP_READ_TIMEOUT=60s
# HTTP_WRITE_TIMEOUT=5m
# HTTP_IDLE_TIMEOUT=120s

# Container memory caps and log rotation (docker-compose.prod.yml). Optional;
# defaults shown, sized for the 2 vCPU / 4 GB VPS — see docs/DEPLOYMENT.md
# "Resource limits and logs". Values use Docker units (b, k, m, g). A container
# that hits its cap is OOM-killed and restarted (restart: unless-stopped).
# POSTGRES_MEM_LIMIT=1g
# REDIS_MEM_LIMIT=256m
# BACKEND_MEM_LIMIT=512m
# WORKER_MEM_LIMIT=512m
# WEB_MEM_LIMIT=512m
# ADMIN_MEM_LIMIT=384m
# CADDY_MEM_LIMIT=128m
# json-file rotation per container: worst case on disk = 7 x size x files (350 MB).
# LOG_MAX_SIZE=10m
# LOG_MAX_FILE=5

# Nightly Postgres backup (read only by infrastructure/deploy/backup.sh, not by
# any container) — see docs/DEPLOYMENT.md "Backups". The script parses these
# lines without executing the file.
# rclone destination base; daily/, weekly/, monthly/ are appended. Credentials
# live in the deploy user's ~/.config/rclone/rclone.conf, never here.
# Empty = the backup FAILS (off-site copy is mandatory), e.g. backup:bookhaven-backups
BACKUP_RCLONE_REMOTE=
# age PUBLIC recipient (age1...). The private identity stays off the server, in
# the password manager. Empty = the backup FAILS.
BACKUP_AGE_RECIPIENT=
# healthchecks.io-compatible ping URL (period 1 day, grace ~2 h); "/fail" is
# appended on failure. Empty = warning only, nobody is alerted.
BACKUP_HEARTBEAT_URL=
# Days of local *.dump files kept in /opt/bookhaven/backups (default 7).
BACKUP_LOCAL_RETENTION_DAYS=7
# BACKUP_OFFSITE=off skips encryption + upload — local testing only, never in production.
# BACKUP_OFFSITE=on

# Error tracking (Sentry), optional. Empty = off.
# Two Sentry projects: Go (api + worker) and Next.js (web + admin). Details:
# docs/DEPLOYMENT.md "Error tracking (Sentry)". SENTRY_RELEASE is filled from
# IMAGE_TAG by docker-compose.prod.yml.
# SENTRY_DSN_BACKEND=
# SENTRY_DSN_FRONTEND=
# SENTRY_ENVIRONMENT=
