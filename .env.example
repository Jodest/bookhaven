APP_ENV=development

# Backend
BACKEND_PORT=8080

# Frontend
WEB_PORT=3000
ADMIN_PORT=3001

# Database
POSTGRES_USER=bookhaven
POSTGRES_PASSWORD=bookhaven
POSTGRES_DB=bookhaven
POSTGRES_PORT=5432

# Cache
REDIS_PORT=6379

# Mailpit (local SMTP catcher; web UI at http://localhost:${MAILPIT_UI_PORT})
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# OAuth (fill in production)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public web origin used for links in emails (e.g. /verify-email).
# Optional in dev (defaults to http://localhost:3000); override only if the
# web app runs elsewhere.
# WEB_BASE_URL=http://localhost:3000

# CORS (comma-separated, no trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# AI pre-moderation of pending books (off by default) — see docs/DEPLOYMENT.md
# "AI pre-moderation". Both the api and the worker need the flag and the key.
# ANTHROPIC_API_KEY is a secret: never commit it.
AI_MODERATION_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODERATION_MODEL=claude-haiku-5-5
AI_MODERATION_CRON="*/30 * * * *"
AI_MODERATION_BATCH=50

# AI curator of author import lists (off by default) — see docs/DEPLOYMENT.md
# "AI author curation". Shares ANTHROPIC_API_KEY; both the api and the worker
# need the flag (and the key).
AI_CURATOR_ENABLED=false
AI_CURATOR_MODEL=claude-haiku-5-5

# AI book description drafts (off by default) — see docs/DEPLOYMENT.md
# "AI book descriptions". Shares ANTHROPIC_API_KEY; both the api and the
# worker need the flag (and the key). Drafts are public only after an admin
# approves them, and only while the book has no description of its own.
AI_DESCRIPTIONS_ENABLED=false
AI_DESCRIPTIONS_MODEL=claude-sonnet-5-5

# AI drafts of manual curated collections (off by default) — see
# docs/DEPLOYMENT.md "AI collection drafts". Shares ANTHROPIC_API_KEY; both the
# api and the worker need the flag (and the key). A draft only proposes books:
# nothing is added to a collection or the catalog without an admin.
AI_COLLECTIONS_ENABLED=false
AI_COLLECTIONS_MODEL=claude-sonnet-5-5

# AI genre suggestions (off by default) — see docs/DEPLOYMENT.md "AI genre
# suggestions". Shares ANTHROPIC_API_KEY; both the api and the worker need the
# flag (and the key). The analysis only proposes genre merges and rejections:
# nothing changes without an admin. AI_GENRES_CRON is a UTC cron spec (empty =
# no weekly run, manual only); AI_GENRES_BATCH is genres per model request.
AI_GENRES_ENABLED=false
AI_GENRES_MODEL=claude-sonnet-5-5
AI_GENRES_CRON="0 3 * * 1"
AI_GENRES_BATCH=300
